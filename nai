#!/data/data/com.termux/files/usr/bin/bash

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MARKER_FILE="$REPO_DIR/.installed"

if [ ! -f "$MARKER_FILE" ]; then
    echo "=========================================="
    echo " NAI First-Time Setup: Installing Tools..."
    echo "=========================================="
    
    pkg update -y && pkg install -y python wget clang cmake git dos2unix

    # Automatically fix line endings for the user
    dos2unix "$REPO_DIR/nai" "$REPO_DIR/main.py" 2>/dev/null
    
    if [ -d "$PREFIX/bin" ]; then
        ln -sf "$REPO_DIR/nai" "$PREFIX/bin/nai"
        chmod +x "$REPO_DIR/nai"
        chmod +x "$PREFIX/bin/nai"
    fi

    touch "$MARKER_FILE"
    echo "Setup complete! Link created: type 'nai' anywhere in Termux."
    sleep 1
fi

python3 "$REPO_DIR/main.py"
